# NeNe Serve — environment template (scaffold, #10). Copy to .env (gitignored).
APP_ENV=local

# Ports (CLAUDE.md): API 8010 · phpMyAdmin 8011 · MySQL 3380
APP_PORT=8010

# Admin JWT signing secret (api-security §6). A non-empty value is always used,
# in every environment. In production it is mandatory — the app refuses to boot
# without it (#136). Generate one with: php -r "echo bin2hex(random_bytes(32));"
NENE_SERVE_JWT_SECRET=
# Opt-in to the injected dev secret when NENE_SERVE_JWT_SECRET is unset. Honored
# only outside production (local/dev/test); production always ignores it and
# requires a real secret. Leave empty here — set to 1 in your local .env (#138).
NENE2_ALLOW_DEV_SECRET=1
# Click token TTL in seconds (ADR 0019); default 900 (15 min). Used from #12.
NENE_SERVE_CLICK_TOKEN_TTL=900

# Where the public-surface rate limiter keeps its counters (#199).
#   database — shared across processes and hosts (default; requires the DB)
#   memory   — per-process array; CANNOT enforce a limit under one-process-per-
#              request, so production refuses to boot with it
# Leave unset in production. Only set it to run without a database locally.
# NENE_SERVE_RATE_LIMIT_STORE=database

# Tenant resolution mode (ADR 0006): how the admin surface determines the org.
#   login         — operator types the org slug at sign-in; it travels in the JWT (default)
#   single        — one fixed org for the whole install (set TENANT_ORG_SLUG)
#   subdomain     — acme.serve.example.com → acme (set TENANT_BASE_DOMAIN)
#   path          — /acme/admin/... → acme
#   custom_domain — tenant's own domain (organizations.custom_domain)
# TENANT_RESOLUTION=login
# TENANT_ORG_SLUG=acme
# TENANT_BASE_DOMAIN=serve.example.com

# Sibling HTTP integrations (HTTP only, ADR 0002). Unset = disabled (Fake clients).
# NENE_INVOICE_API_BASE_URL=https://invoice.internal
# NENE_INVOICE_SERVICE_TOKEN=
# NENE_RECORDS_API_BASE_URL=https://records.internal   # read-only
# NENE_RECORDS_SERVICE_TOKEN=
# NENE_DEAL_API_BASE_URL=https://deal.internal
# NENE_DEAL_SERVICE_TOKEN=
# Governed retention purge runs under a PRIVILEGED DB role (not the app role):
# PURGE_DB_USERNAME= / PURGE_DB_PASSWORD=

# Database (container-internal port is 3306; host-exposed port is 3380).
# NENE2 reads DB_NAME / DB_USER; DB_DATABASE / DB_USERNAME are the docker-compose
# interpolation names for the db service. Keep them in sync.
DB_HOST=db
DB_PORT=3306
DB_NAME=nene_serve
DB_USER=nene
DB_DATABASE=nene_serve
DB_USERNAME=nene
DB_PASSWORD=nene
DB_ROOT_PASSWORD=root
