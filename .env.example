# NeNe Serve — environment template (scaffold, #10). Copy to .env (gitignored).
APP_ENV=local

# Ports (CLAUDE.md): API 8910 · phpMyAdmin 8911 · MySQL 3392
APP_PORT=8910

# Database (container-internal port is 3306; host-exposed port is 3392)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nene_serve
DB_USERNAME=nene
DB_PASSWORD=nene
DB_ROOT_PASSWORD=root
