# NeNe Serve — environment template (scaffold, #10). Copy to .env (gitignored).
APP_ENV=local

# Ports (CLAUDE.md): API 8910 · phpMyAdmin 8911 · MySQL 3392
APP_PORT=8910

# Admin JWT signing secret (api-security §6) — set a strong value in production.
NENE_SERVE_JWT_SECRET=dev-insecure-secret-change-me
# Click token TTL in seconds (ADR 0019); default 900 (15 min). Used from #12.
NENE_SERVE_CLICK_TOKEN_TTL=900

# Sibling HTTP integrations (HTTP only, ADR 0002). Unset = disabled (Fake clients).
# NENE_INVOICE_API_BASE_URL=https://invoice.internal
# NENE_INVOICE_SERVICE_TOKEN=
# NENE_RECORDS_API_BASE_URL=https://records.internal   # read-only
# NENE_RECORDS_SERVICE_TOKEN=
# Governed retention purge runs under a PRIVILEGED DB role (not the app role):
# PURGE_DB_USERNAME= / PURGE_DB_PASSWORD=

# Database (container-internal port is 3306; host-exposed port is 3392)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nene_serve
DB_USERNAME=nene
DB_PASSWORD=nene
DB_ROOT_PASSWORD=root
